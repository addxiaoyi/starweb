# =============================================================================
# StarMC 网站后端（Node）环境变量示例
# =============================================================================
#
# 【怎么用】
#   0. 更推荐先看仓库根 `docs/SIMPLE_CONFIG.md`，只改 `tools/starmc-simple-config.env`，
#      再运行 `node tools/starmc-config-wizard.mjs --write` 自动生成 `backend/.env.generated`。
#   1. 本地 simple flow：直接用 `npm run dev:simple` / `npm run start:simple`，只读取 `.env.generated`。
#   2. 若你确实需要手工覆盖，再复制本文件为同目录下的 `.env`（不要提交密钥到 Git），并使用 `npm run dev` / `npm run start`。
#   3. 改完 `.env.generated` 或 `.env` 后，都需要重启 Node 进程才会生效。
#
# 【书写规则】
#   - `#` 开头为注释；`KEY=value` 不要加引号，除非值里含空格。
#   - 布尔常用：`1` / `0`、`true` / `false`、`on` / `off`（具体见 `config.js` 里 envTruthy）。
#   - 多个 URL/域名：英文逗号分隔，不要换行拆同一个值（除非变量本身支持多行，见各条说明）。
#
# 【和代码的对应关系】
#   所有变量在 `src/config.js` 中读取并带默认值；本文件仅列出常用项，未写的项用代码内默认。
#
# 【文档与获取方式（官方链接，便于自学）】
#   Node 从文件加载环境变量（--env-file）：https://nodejs.org/docs/latest/api/cli.html#--env-filefile
#   Vite 前端环境变量说明： https://vitejs.dev/guide/env-and-mode.html
#   SuperTokens 总文档： https://supertokens.com/docs
#   SuperTokens Core 自托管（Docker/二进制）： https://github.com/supertokens/supertokens-core
#   Express 在反向代理后获取真实 IP（TRUST_PROXY）： https://expressjs.com/en/guide/behind-proxies.html
#   Cloudflare 请求头 CF-IPCountry 说明： https://developers.cloudflare.com/fundamentals/reference/http-request-headers/#cf-ipcountry
#   国家/地区两位码（配 GEO 时可查）： https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2
#   本项目「网站 ⟷ VLA 插件」对接长文：仓库内 `velocity-limbo-auth/开发清单与网站对接全流程.md`
#   本地 OpenAPI（AuthX 契约示例）：启动 API 后浏览器打开 `http://127.0.0.1:<PORT>/api/docs/openapi/authx`
#
# =============================================================================

NODE_ENV=development

# --- 端口 ---
# API 服务（Express）：前端 Vite 代理 `/api` 时一般指向本端口。
PORT=8787
# 第二个小端口：历史兼容「插件桩」健康检查（可选，多数场景与 AUTHX_PLUGIN_BASE 无关）
PLUGIN_PORT=8788

# =============================================================================
# 网站业务数据（JSON 文件库）与备份
# =============================================================================
# 【架构说明】
#   - 本站后端用单个 store.json 存：用户扩展字段、皮肤状态、邀请码占用、插件回调审计等。
#   - Minecraft 登录账号 / 密码哈希 / 设备指纹等在 Velocity 插件（VLA）自己的数据库里，见 velocity-limbo-auth 的 database.*。
#   - 若要多实例水平扩展或复杂查询，需另行引入 PostgreSQL 等并把 persist 层替换为真实 DB（当前仓库未内置）。
#
# 【数据目录】未设置时默认为 backend/data（含 store.json、uploads/、backups/）。
# 生产可挂到独立盘或 Docker volume，例如：
# DATA_DIR=/var/lib/starmc-api/data
#
# 【轮转备份】生产 NODE_ENV=production 时默认开启；开发默认关闭。也可显式：
# STORE_BACKUP_ENABLED=1
# STORE_BACKUP_INTERVAL_MINUTES=60
# STORE_BACKUP_KEEP=48
#
# 【健康检查】GET /api/health 的 persist 字段含 lastSaveAt、storeBytes、backupCount 等。
# 生产若不想暴露绝对路径，勿设 HEALTH_PERSIST_DETAIL=1（默认生产为 false）。
# HEALTH_PERSIST_DETAIL=0

# =============================================================================
# PostgreSQL（网站业务扩展：player_state + user_profile + submission JSONB）
# =============================================================================
# 未设置 DATABASE_URL 时仅使用 store.json（与旧行为一致）。
# 裸机 PostgreSQL 示例（按你的用户/库修改）：
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/starmc_site
# 可选 Docker（site-postgres 映射 5433）：postgres://starmc:starmc@127.0.0.1:5433/starmc_site
# 仅迁移不启动 API：npm run db:migrate
# 关闭启动时自动迁移：PG_MIGRATE_ON_START=0
# 连接池上限（可选）：PG_POOL_MAX=10
# 关闭启动后全量同步 site_store_kv（邀请码/回调日志/大厅目录/改密挑战）：PG_KV_SYNC_ON_START=0
#
# GET /api/health 附带 PostgreSQL 各表行数（聚合查询）：HEALTH_PG_STATS=1
# 命令行仅查行数：npm run db:stats

# --- 浏览器跨域（CORS）---
# 允许哪些网页来源带 Cookie 访问本 API。多个 origin 用英文逗号分隔，无尾斜杠。
# 生产环境务必设为你的真实站点，例如：https://www.example.com
# Comma-separated allowed origins for browser requests.
# Example:
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 邮件里的「站点首页」链接、部分重定向用（与 Vite 开发地址一致即可）
# PUBLIC_SITE_ORIGIN=http://localhost:5173

# =============================================================================
# SuperTokens（网站登录 / 会话，替代 Casdoor）
# =============================================================================
# 【做什么】浏览器通过 SuperTokens 完成邮箱注册、登录、会话刷新；本后端用 supertokens-node 与 Core 通信。
# 【官方入门】https://supertokens.com/docs/quickstart/introduction
# 【怎么配】Core 默认监听 3567。后端只认 SUPERTOKENS_CONNECTION_URI。
#   · 裸机（推荐）：官方安装包/二进制，按文档配置元数据库并启动；连接串示例 http://127.0.0.1:3567
#   · 可选 Docker：在「重构」目录 docker compose up -d supertokens-db supertokens
#   细节见 backend/README.md；自检：npm run doctor
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
# 生产若 Core 开启了 API Key，这里填同一个：
# SUPERTOKENS_API_KEY=
# SUPERTOKENS_APP_NAME=StarMC
#
# 【与前端必须一致】须与前端环境变量 VITE_AUTH_* / 前端文档一致，否则登录会跨域或 Cookie 异常。
# 推荐开发：Vite 把 /api、/auth 代理到本机 → 浏览器视角「网站与 API 同源」，填 localhost:5173：
AUTH_API_DOMAIN=http://localhost:5173
AUTH_WEBSITE_DOMAIN=http://localhost:5173
# 若前端直连 API（不设代理、VITE_API_BASE=https://www.star-web.top），则 API 域改为后端地址，例如：
# AUTH_API_DOMAIN=https://www.star-web.top
# AUTH_WEBSITE_DOMAIN=http://localhost:5173
#
# AUTH_API_BASE_PATH=/auth
# AUTH_WEBSITE_BASE_PATH=/auth

# =============================================================================
# SMTP / IMAP（发「验证邮箱」「忘记网站密码」等邮件）
# =============================================================================
# 【SuperTokens 侧邮件投递说明】https://supertokens.com/docs/email-delivery/about
# 【注意】不配时开发环境只会把链接打印到控制台；生产必须配，否则用户收不到信。
# SUPERTOKENS_SMTP_HOST=smtp.feishu.cn
# SUPERTOKENS_SMTP_PORT=587
# 发件人邮箱；多数服务商发件账号与 SMTP 登录名相同，不同则单独设 USER
# SUPERTOKENS_SMTP_FROM_EMAIL=MC@star-mc.top
# SUPERTOKENS_SMTP_FROM_NAME=StarMC
# SUPERTOKENS_SMTP_USER=MC@star-mc.top
# SUPERTOKENS_SMTP_PASSWORD=your-feishu-imap-smtp-password
# SUPERTOKENS_IMAP_HOST=imap.feishu.cn
# SUPERTOKENS_IMAP_PORT=993
# SUPERTOKENS_IMAP_SECURE=1
# 使用 465 且全程 SSL 时：SUPERTOKENS_SMTP_SECURE=1
# 别名：也可用 SMTP_HOST、SMTP_PORT、SMTP_USER…（见 config.js）

# =============================================================================
# GitHub OAuth 第三方登录
# =============================================================================
# 【注册 OAuth App】https://github.com/settings/applications/new
#   · Application name: StarMC
#   · Homepage URL: https://your-domain.com
#   · Authorization callback URL: https://your-domain.com/auth/callback/github
# 获取 Client ID 和 Client Secret 后填入：
OAUTH_GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
OAUTH_GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
# 可选：显式指定回调 URI（留空则自动拼为 {websiteDomain}/auth/callback/github）
# OAUTH_GITHUB_REDIRECT_URI=https://your-domain.com/auth/callback/github
# 【GitHub 登录后】用户必须绑定邮箱才能使用皮肤站等核心功能（由后端 requireEmailVerifiedForSkinActions 控制）

# =============================================================================
# 安全相关密钥（生产环境必填项）
# =============================================================================
# PLUGIN_REFRESH_SECRET
#   - 生产环境（NODE_ENV=production）下必须设置，否则 POST /plugin/skin/refresh 返回 503。
#   - 开发环境可不设（便于本地桩）；若设置则请求必须带对密钥。
#   - 请求头：X-Skin-Bridge-Secret 或 X-Skinbridge-Secret（与插件配置一致）。
# DEV_ADMIN_SECRET
#   - 生产环境必须设置，否则 /api/admin/authx/*、/api/plugin/authx/events 等管理接口返回 503。
#   - 请求头：X-Admin-Secret
#   - 开发环境可不设；若设置则访问上述接口也必须带头（与预发一致）。
#
# 生产部署请取消注释并换成高强度随机串（勿提交 Git）：
# PLUGIN_REFRESH_SECRET=
# DEV_ADMIN_SECRET=

# =============================================================================
# Velocity-Limbo-Auth（VLA）与网站对接
# =============================================================================
# 【Velocity 代理下载】https://papermc.io/downloads/velocity
# 【本仓库插件源码与配置】`velocity-limbo-auth/`，联调目录 `velocity-test/`
# 【整体概念】游戏内账号在代理插件里；网站要通过 HTTP 帮玩家改密、绑邮箱、刷新皮肤等，就要让本后端能访问「插件 HTTP」。
# 【注意】旧 AuthX 适配器已废弃，仅 VLA 受支持；AUTHX_PLUGIN_ADAPTER 默认即为 vla。
#
# 插件→网站回调（事件通知）：
#   POST /api/plugin/authx/callback
#   VLA 出站：头 X-VLA-Signature（hex），正文 JSON；验签密钥：
#     AUTHX_VLA_WEBHOOK_SECRET=单条，或
#     AUTHX_VLA_WEBHOOK_SECRETS=多行多条（与插件多个 endpoint secret 一一对应；密钥里若含 | 请只用换行分隔）
#   【生产必填】须至少配置一条 VLA 出站密钥，否则 POST /api/plugin/authx/callback 恒为 503。
#   回调单 IP 限流（每分钟，默认 45，叠加全局限流）；可调：# RATE_LIMIT_AUTHX_CALLBACK=60
#
# 网站→插件管理接口（改密、封禁、链网站用户等）：
#   AUTHX_PLUGIN_BASE=插件监听的根 URL，无尾斜杠，例如 http://127.0.0.1:8090
#   适配器 vla：需 AUTHX_VLA_API_KEY，与插件 config 里 http-api.api-key 一致；
#   若插件开启了 write-security.require-hmac，再配 AUTHX_VLA_HMAC_SECRET。
#
# AUTHX_PLUGIN_ADAPTER=vla
# AUTHX_PLUGIN_BASE=http://127.0.0.1:8090
# AUTHX_VLA_API_KEY=与 VLA http-api.api-key 一致
# AUTHX_VLA_HMAC_SECRET=与 VLA http-api.write-security.hmac-secret 一致
#
# 调用插件超时（毫秒），默认 10000
# AUTHX_PLUGIN_REQUEST_MS=10000

# =============================================================================
# 皮肤站公开档案 ⟷ VLA custom-profile-url（闭环）
# =============================================================================
# 【做什么】玩家进服后插件按 URL 拉 JSON；PUBLIC_API_BASE_URL 必须能被代理/玩家访问（不要用 localhost 指到别的机器）。
# PUBLIC_API_BASE_URL=https://api.your-domain.com
#
# 插件侧对应示例（与上同源）：
#   skin.provider: custom
#   custom-profile-url: "https://api.your-domain.com/api/public/skin-profile/{username}.json"
#   # {username} = 进服名；优先返回本站已绑定 linkedMcUsername 的皮肤，其次 Mojang 正版皮肤，最后默认皮肤
# 出站回调示例见仓库文档；网站验签用 AUTHX_VLA_WEBHOOK_SECRET(S)
#
# SKIN_BRIDGE_PUBLIC_PROFILE=0  # 关闭公开 GET 档案
# SKIN_BRIDGE_MOJANG_FALLBACK=0 # 关闭未绑定账号时按进服名查询 Mojang 皮肤
# SKIN_BRIDGE_DEFAULT_FALLBACK=0 # 关闭 Mojang 也查不到时的默认皮肤兜底
# SKIN_BRIDGE_DEFAULT_SKIN_URL=http://textures.minecraft.net/texture/60a5bd016b3c9a1b9272e4929e30827a67be4ebb219017adbbc4a4d22ebd5b1
# SKIN_BRIDGE_DEFAULT_MODEL=default # default 或 slim
# VLA_NOTIFY_ON_SKIN_CHANGE=0     # 关闭网站侧自动 POST /v1/skin/refresh
# RATE_LIMIT_SKIN_PROFILE_PUBLIC=180  # 公开档案每分钟请求上限
# REVIEW_ENTRY_ENABLED=1              # 启用审核入口与真实审核 API（建议先灰度内部审核员）
#
# 【Mojang 正版皮肤 → 写入 store.json】API 说明见 https://minecraft.wiki/w/Mojang_API
# 绑定游戏角色成功后会后台尝试同步；用户亦可 POST /api/skins/player/sync-mojang 手动拉取。
# MOJANG_SKIN_SYNC_ENABLED=0
# 须为可识别的 UA（含项目或联系方式），勿留空
# MOJANG_API_USER_AGENT=YourServer-SkinSync/1.0 (you@example.com)
# MOJANG_API_TIMEOUT_MS=12000
# RATE_LIMIT_MOJANG_SKIN_SYNC=8   # 每用户每分钟「手动同步」次数上限
# RATE_LIMIT_UPLOADS_READ=240      # /uploads 每 IP 每分钟读取上限（防资源遍历抓取）
# RATE_LIMIT_AUTH=20               # /auth 每 IP 15 分钟上限（防暴力破解）
# BOT_UA_BLOCKLIST=sqlmap|nikto|masscan  # 额外拦截的可疑 UA 关键字（正则，|/逗号分隔）

# =============================================================================
# 游戏库密码（邮件验证码 → 网站调 VLA 改密）
# =============================================================================
# 【流程】用户在页面「重置游戏进服密码」→ 后端发邮件 6 位码 → 用户填码+新密码 → 后端 POST 插件 /v1/admin/password。
# 【前提】AUTHX_PLUGIN_ADAPTER=vla、插件 http-api.allow-writes=true、且 SMTP 已配置。
# MC_GAME_PASSWORD_RESET_ENABLED=1
# 验证码有效时间（分钟）
# MC_PASSWORD_RESET_TTL_MINUTES=15
# 同一角色名 1 分钟内最多申请几次验证码（防刷）
# MC_PASSWORD_RESET_BURST_PER_MIN=1
# RATE_LIMIT_MC_GAME_PW_REQUEST=12    # 每 IP 每小时「申请验证码」次数上限
# RATE_LIMIT_MC_GAME_PW_CONFIRM=20    # 每 IP 每 15 分钟「确认改密」次数上限

# =============================================================================
# 运营策略：邀请码 / 地区 / 两步验证（TOTP）
# =============================================================================
# 【TOTP / RFC 6238 背景】https://www.rfc-editor.org/rfc/rfc6238 （本站用 otplib 校验）
# 【邀请码】INVITE_CODES_REQUIRED_FOR_MC_LINK=1 时，用户绑定游戏角色必须在请求里带邀请码；
# INVITE_CODES 为英文逗号分隔白名单；每个码全局只能被一个网站账号「占用」绑定。
# INVITE_CODES_REQUIRED_FOR_MC_LINK=0
# INVITE_CODES=ALPHA2026,BETA2026
#
# 【地区】依赖 Cloudflare CF-IPCountry 或自行反代传 X-Country-Code（ISO 两位大写）。
# 仅拦截「敏感写操作」路径前缀，不拦截登录（详见后端 inviteAndGeo.js 默认列表）。
# GEO_BLOCKED_COUNTRIES=
# 若需自定义拦截哪些 API 路径，再设（逗号分隔前缀）；留空用内置默认：
# GEO_BLOCKED_PATH_PREFIXES=
#
# 【TOTP】用户在个人中心可启用两步验证；开启 REQUIRE_TOTP_FOR_MC_LINK 后，绑定/解绑游戏名须额外传 totpCode。
# REQUIRE_TOTP_FOR_MC_LINK=0
# TOTP_ISSUER=StarMC

# =============================================================================
# 其它
# =============================================================================
# 将浏览器 web-vitals 打到控制台（需前端配置上报地址）
# LOG_WEB_VITALS=1
# WEB_VITALS_ALERT_LOG=1
# SECURITY_LOG_MASK_IP=1  # 建议保持默认：日志中的 IP 仅保留网段（代码默认已脱敏）

# 反代后拿真实客户端 IP 时开启
# TRUST_PROXY=1
# BCRYPT_ROUNDS=11
# MAX_SESSIONS_PER_USER=10
# RATE_LIMIT_MC_USER=60
# RATE_LIMIT_ADMIN_PLUGIN_GET=120
# ALLOW_DEV_APPROVE=1
