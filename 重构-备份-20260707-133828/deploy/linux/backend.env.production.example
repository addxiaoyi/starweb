# =============================================================================
# 本地单机部署示例（Linux，无容器）
# 用法：复制到 /etc/starmc/starmc-api.env 并 chmod 600
# =============================================================================

NODE_ENV=production

# 仅监听本机，由 Nginx 反代
PORT=8787
PLUGIN_PORT=8788
TRUST_PROXY=1

# 本地访问域（可改成你的内网域名，如 https://starmc.lan）
CORS_ORIGIN=http://127.0.0.1,http://localhost
PUBLIC_SITE_ORIGIN=http://127.0.0.1

# SuperTokens appInfo 域名（需与浏览器访问前端地址一致）
AUTH_API_DOMAIN=http://127.0.0.1
AUTH_WEBSITE_DOMAIN=http://127.0.0.1

# SuperTokens Core（裸机独立进程）
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
# SUPERTOKENS_API_KEY=

# 对外 API 根（生产环境改为你的站点域名）
PUBLIC_API_BASE_URL=https://www.star-web.top
SKIN_BRIDGE_PUBLIC_PROFILE=1
SKIN_BRIDGE_MOJANG_FALLBACK=1
SKIN_BRIDGE_DEFAULT_FALLBACK=1
# SKIN_BRIDGE_DEFAULT_SKIN_URL=http://textures.minecraft.net/texture/60a5bd016b3c9a1b9272e4929e30827a67be4ebb219017adbbc4a4d22ebd5b1
# SKIN_BRIDGE_DEFAULT_MODEL=default

# 本地数据目录
DATA_DIR=/var/lib/starmc-api/data
HEALTH_PERSIST_DETAIL=0

# 可选：PostgreSQL（不配置则仅使用 DATA_DIR/store.json）
# DATABASE_URL=postgres://starmc:starmc@127.0.0.1:5432/starmc_site

# 可选：SMTP（不配则邮件验证不可用）
# SUPERTOKENS_SMTP_HOST=smtp.qq.com
# SUPERTOKENS_SMTP_PORT=587
# SUPERTOKENS_SMTP_USER=example@qq.com
# SUPERTOKENS_SMTP_PASSWORD=your_smtp_auth_code
# SUPERTOKENS_SMTP_FROM_EMAIL=example@qq.com
# SUPERTOKENS_SMTP_FROM_NAME=StarMC

# 可选：VLA 插件联动
# AUTHX_PLUGIN_ADAPTER=vla
# AUTHX_PLUGIN_BASE=http://127.0.0.1:8090
# AUTHX_VLA_API_KEY=replace_me
# AUTHX_VLA_WEBHOOK_SECRET=replace_me
