NODE_ENV=production

# -----------------------------
# 基础端口与跨域（按实际域名修改）
# -----------------------------
PORT=8787
PLUGIN_PORT=8788
CORS_ORIGIN=https://your-site.example.com
PUBLIC_SITE_ORIGIN=https://your-site.example.com
PUBLIC_API_BASE_URL=https://api.your-site.example.com

# -----------------------------
# StarVelocity (VLA) 对接
# -----------------------------
# 注意：旧 AuthX 适配器已废弃，仅 VLA 受支持；AUTHX_PLUGIN_ADAPTER 默认即为 vla。
AUTHX_PLUGIN_ADAPTER=vla
AUTHX_PLUGIN_BASE=http://127.0.0.1:8090

# 与 StarVelocity 的 http-api.api-key 完全一致
AUTHX_VLA_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# 与 StarVelocity outbound webhook secret 完全一致
AUTHX_VLA_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY

# 若 StarVelocity 开启 write-security.require-hmac=true，则必须配置
# AUTHX_VLA_HMAC_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY

# -----------------------------
# 生产安全必填（已做 fail-closed）
# -----------------------------
PLUGIN_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY
DEV_ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY

# 可选：回调限流（每 IP 每分钟），默认 45
# RATE_LIMIT_AUTHX_CALLBACK=60

# -----------------------------
# Telemetry（新增）
# -----------------------------
# 遥测总开关（0=关闭前后端采集落盘）
TELEMETRY_ENABLED=1
# 每分钟每 IP 遥测事件上限
TELEMETRY_RATE_LIMIT_PER_MINUTE=600
# 遥测保留天数（1~90）
TELEMETRY_RETENTION_DAYS=14
# 管理接口来源 IP 白名单（逗号分隔；空则不限制）
# ADMIN_ALLOWED_IPS=127.0.0.1,::1
# 结构化 API 日志
# LOG_STRUCTURED_API=1
# 路由遥测调试日志
# LOG_ROUTE_TELEMETRY=0

# -----------------------------
# SuperTokens（生产）
# -----------------------------
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
AUTH_API_DOMAIN=https://api.your-site.example.com
AUTH_WEBSITE_DOMAIN=https://your-site.example.com
AUTH_API_BASE_PATH=/auth
AUTH_WEBSITE_BASE_PATH=/auth

# -----------------------------
# 邮件（建议生产必须配置）
# -----------------------------
# SUPERTOKENS_SMTP_HOST=smtp.your-mail.com
# SUPERTOKENS_SMTP_PORT=587
# SUPERTOKENS_SMTP_USER=your-user
# SUPERTOKENS_SMTP_PASSWORD=your-password
# SUPERTOKENS_SMTP_FROM_EMAIL=noreply@your-site.example.com
# SUPERTOKENS_SMTP_FROM_NAME=StarMC
# SUPERTOKENS_SMTP_SECURE=0

# -----------------------------
# 可选：数据库（未配置则使用 data/store.json）
# -----------------------------
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/starmc_site
# HEALTH_PG_STATS=1
