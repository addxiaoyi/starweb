{
  "name": "starmc-refactor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "dev:all": "bash ./scripts/start-all.sh",
    "dev:all:win": "powershell -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "setup:linux": "bash ./scripts/setup-linux.sh",
    "start:all": "npm run dev:all",
    "doctor:startup": "bash ./scripts/doctor-startup.sh",
    "check:forbidden-strings": "node ./scripts/check-forbidden-strings.mjs",
    "lint": "eslint src tests vite.config.ts eslint.config.js --max-warnings 80",
    "lint:fix": "eslint src tests vite.config.ts eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.eslint.json eslint.config.js vite.config.ts vite.proxy.config.ts playwright.config.ts tailwind.config.js index.html",
    "build": "vue-tsc --noEmit && vite build",
    "check:perf-budget": "node ./scripts/check-performance-budget.mjs",
    "check:security-baseline": "node ./scripts/check-security-baseline.mjs",
    "preview": "vite preview",
    "prerender": "node ./scripts/prerender.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test e2e/a11y-baseline.spec.ts",
    "test:e2e:critical": "playwright test e2e/critical-auth-skin-sync.spec.ts",
    "verify": "npm run check:forbidden-strings && npm run lint && npm run format:check && npm run test:unit && npm run build",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@shopify/draggable": "^1.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@unhead/vue": "^2.1.12",
    "@vueuse/core": "^14.2.1",
    "dompurify": "^3.4.2",
    "grid-layout-plus": "^1.1.1",
    "gsap": "^3.14.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "ogl": "^1.0.11",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "skinview3d": "^3.4.1",
    "three": "^0.160.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.58.2",
    "@storybook/vue3-vite": "^10.3.5",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.70.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "braces": "^3.0.3",
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.14",
    "serialize-javascript": "^7.0.5"
  }
}
