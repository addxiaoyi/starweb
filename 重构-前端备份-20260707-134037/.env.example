# =============================================================================
# StarMC 网站前端环境变量示例
# =============================================================================
#
# 用法：
#   1. 复制本文件为同目录下的 `.env.local` 或 `.env`
#   2. 本前端使用 Vite，变量必须以 `VITE_` 开头才会暴露给浏览器
#   3. 开发环境建议由 `scripts/start-all.sh` 自动分配端口后再启动前端
#
# 说明：
#   - 这里放的是前端常用配置；后端配置请看 `backend/.env.example`
#   - 路径尽量使用相对路径/同源代理，不要写死本机绝对地址，方便迁移

# 前端对外显示的站点名（可选）
VITE_SITE_NAME=StarMC

# 后端 API 基地址
# 开发默认走同源代理时可留空；若前后端分离部署，请填写完整 URL
# 例如：https://www.star-web.top
VITE_API_BASE=

# 站点公开地址（用于生成分享链接、SEO、邮件跳转）
# 例如：http://localhost:5173
VITE_PUBLIC_SITE_ORIGIN=

# 后端鉴权/会话相关的前端站点域名（若项目中需要显式读取，可在这里统一）
# AUTH_API_DOMAIN=http://localhost:5173
# AUTH_WEBSITE_DOMAIN=http://localhost:5173

# 若你使用自定义的资源前缀，可在此统一
# VITE_UPLOADS_BASE=
