# 项目内本地化部署（无 root / 无 systemd）
# 复制为：deploy/linux/project-local.env
# 用途：统一给启动脚本读取（SuperTokens Core + backend + web）

# 项目根（默认自动推导，可不改）
PROJECT_ROOT=/srv/starmc-website/重构

# 对外访问地址（本地示例）
PUBLIC_HOST=127.0.0.1
PUBLIC_SCHEME=http
PUBLIC_PORT=80

# 后端端口
API_PORT=8787
PLUGIN_PORT=8788

# 前端预览端口（vite preview）
WEB_PORT=4173

# SuperTokens Core 端口
SUPERTOKENS_PORT=3567

# SuperTokens 元数据库（MySQL 示例）
MYSQL_CONNECTION_URI=mysql://supertokens:replace_me@127.0.0.1:3306/supertokens
# PostgreSQL 可替换为：
# POSTGRESQL_CONNECTION_URI=postgresql://supertokens:replace_me@127.0.0.1:5432/supertokens

# 可选：若 Core 设置 API key，后端要同步
# SUPERTOKENS_API_KEY=replace_me
