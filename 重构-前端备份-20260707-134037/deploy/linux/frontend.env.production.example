# =============================================================================
# 本地单机部署示例（Linux，无容器）
# 用法：复制为 重构/.env.production.local 后执行 npm run build
# =============================================================================

# 与浏览器访问地址一致
VITE_AUTH_API_DOMAIN=http://127.0.0.1
VITE_AUTH_WEBSITE_DOMAIN=http://127.0.0.1
VITE_AUTH_API_BASE_PATH=/auth
VITE_SUPERTOKENS_APP_NAME=StarMC

# 本地同机，一般不需要单独配置 API 基址（由 Nginx 同源反代）
# VITE_API_BASE=https://www.star-web.top

VITE_WEB_VITALS_ENDPOINT=/api/metrics/web-vitals
