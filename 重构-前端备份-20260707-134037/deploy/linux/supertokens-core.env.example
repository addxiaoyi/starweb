# SuperTokens Core 裸机环境变量示例
# 用法：复制到 /etc/supertokens/core.env
#
# 说明：SuperTokens Core 需要自己的元数据库（MySQL/PostgreSQL 其一）。
# 若按 deploy/linux/install-supertokens-core-no-docker.sh 默认参数安装，
# 推荐先使用 PostgreSQL 示例（plugin=postgresql, tag=11.4.4）。

# Core HTTP 监听端口（与 backend SUPERTOKENS_CONNECTION_URI 保持一致）
PORT=3567

# ========= PostgreSQL 示例（推荐） =========
POSTGRESQL_CONNECTION_URI=postgresql://supertokens:replace_me@127.0.0.1:5432/supertokens

# ========= MySQL 示例（如用 MySQL，请注释掉 POSTGRESQL_CONNECTION_URI） =========
# 先自行准备数据库与账号：
#   CREATE DATABASE supertokens;
#   CREATE USER 'supertokens'@'127.0.0.1' IDENTIFIED BY 'replace_me';
#   GRANT ALL PRIVILEGES ON supertokens.* TO 'supertokens'@'127.0.0.1';
#   FLUSH PRIVILEGES;
# MYSQL_CONNECTION_URI=mysql://supertokens:replace_me@127.0.0.1:3306/supertokens

# 可选：API Key（若设置，backend 需同步 SUPERTOKENS_API_KEY）
# API_KEYS=replace_with_strong_key
